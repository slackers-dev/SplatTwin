# Verbindung zum RunPod-Pod. Kopieren nach pod.env (nicht im Repo) und ausfuellen.
# Werte stehen in RunPod beim Pod unter "Connect" -> "SSH over exposed TCP":
#   ssh root@<POD_HOST> -p <POD_PORT> -i <POD_KEY>
# Nach jedem Neustart des Pods koennen sich Adresse und Port aendern.
POD_HOST=
POD_PORT=
POD_USER=root
# Pfad zum privaten SSH-Schluessel, leer = Standardschluessel von ssh
POD_KEY=
