{
  "name": "splattwin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Splattwin im Browser: Tracking, Aufnahme, Splat-Viewer und Zuschauerseite",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "check:contracts": "node scripts/gen-contracts.mjs --check"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "@sparkjsdev/spark": "2.4.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/three": "0.180.0",
    "ajv": "^8.20.0",
    "eslint": "^10.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.1"
  }
}
