{
  // core ist reine Mathematik: kein DOM, kein three.js, kein MediaPipe. Die fehlende DOM-Bibliothek
  // laesst jeden Zugriff auf window, document oder HTMLVideoElement schon beim Kompilieren scheitern.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "../../.tsbuild/core",
    "rootDir": "..",
    "tsBuildInfoFile": "../../.tsbuild/core.tsbuildinfo",
    "lib": ["ES2023"],
    "types": [],
    // Matrizen und Vektoren fester Groesse, Indexzugriffe in Schleifen: das Flag braechte hier nur
    // Ausrufezeichen. In der App (fehlende Gelenke) bleibt es an.
    "noUncheckedIndexedAccess": false
  },
  "include": ["./**/*.ts", "../contracts/**/*.ts"],
  "exclude": ["../**/*.test.ts"]
}
